# ============================================================
# ALYASMEEN AuntOps — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit your real .env to source control
# ============================================================

# --- Mode ---
# 1 = local dev (messages printed to console), 0 = production
USE_MOCK_WHATSAPP=1

# --- Database (Supabase — HTTPS) ---
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role (secret) key — bypasses RLS. Used by app/db/database.py for all app data,
# and by app/services/auth.py for admin-only operator management (create user, delete MFA
# factors, list users). Never expose this to the dashboard's client-side code.
SUPABASE_KEY=your_service_role_key_here
# anon/public key — used ONLY by app/services/auth.py for the non-admin Supabase Auth
# surface (password sign-in, TOTP MFA enroll/verify, password-reset email). Get it from
# the same Project API keys page as SUPABASE_KEY, just the "anon public" row instead of
# "service_role secret".
SUPABASE_ANON_KEY=your_anon_key_here

# --- Worker job-store persistence (APScheduler) ---
# Postgres connection string so scheduled jobs (e.g. the monthly report cron) survive a
# worker restart. Use the Supabase SESSION POOLER string (port 5432, host
# aws-<region>.pooler.supabase.com, user postgres.<project-ref>) — NOT the "Direct
# connection" string (db.<ref>.supabase.co), which is IPv6-only and will not resolve on
# Railway's default IPv4-only outbound networking. Must start with postgresql:// (not
# postgres://) — SQLAlchemy 2.0 rejects the old scheme. Get it from: Supabase Dashboard →
# Settings → Database → Connection string → Session pooler. Without this set, the worker
# falls back to an in-memory job store (scheduling state is lost on every restart).
DATABASE_URL=

# --- Claude AI (Anthropic) ---
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- WhatsApp (Meta Cloud API) ---
# Get from: Meta Developer Portal → Your App → WhatsApp → API Setup
WA_META_TOKEN=
WA_META_PHONE_ID=
WA_META_VERIFY_TOKEN=
WA_META_APP_SECRET=

# --- Web Dashboard ---
DASHBOARD_PASSWORD=your_strong_password_here
SECRET_KEY=change-me-to-a-long-random-string

# --- Aunt notifications + monthly report ---
# WhatsApp number: country code + number, no + or spaces (e.g. 972591234567)
AUNT_PHONE=

# --- Admin (Khaled) ---
# Receives new-device dashboard login alerts and every permanent-failure alert (the aunt
# only gets customer-facing failures; Khaled gets everything). Same format as AUNT_PHONE.
ADMIN_PHONE=

# --- Dashboard base URL ---
# Used as the redirect_to target for Supabase Auth password-reset emails
# (https://alyasmeen.org in production, http://localhost:8000 for local dev — that's
# also the default if this is left unset).
DASHBOARD_BASE_URL=http://localhost:8000

# NOTE: Supabase's built-in email provider (used for password-reset emails above) is
# capped at 2 emails/hour project-wide. Test password-reset flows sparingly — repeated
# "over_email_send_rate_limit" errors are a platform limit, not an app bug.

# Invoicing is a PDF generated on order completion (app/services/pdf_invoice.py) —
# no external invoicing service or API keys required.
